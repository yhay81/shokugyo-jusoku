{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shokugyo-jusoku",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "shokugyo-jusoku.yhay81.com", "custom_domain": true }],
  "triggers": { "crons": ["11 23 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shokugyo-jusoku",
      "database_id": "cf0c243b-a560-435a-93ef-225a7f643272",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
